{
  "name": "@we-the-rebel-alliance/tavily-plugin",
  "version": "0.0.0",
  "private": true,
  "description": "Tavily web search, page reading, site maps and crawls, and cited research for OpenCode",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tavily"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/we-the-rebel-alliance/tavily-plugin.git"
  },
  "homepage": "https://github.com/we-the-rebel-alliance/tavily-plugin#readme",
  "bugs": {
    "url": "https://github.com/we-the-rebel-alliance/tavily-plugin/issues"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js",
    "./icon.svg": "./assets/icon.svg",
    "./icon-128.png": "./assets/icon-128.png",
    "./icon-256.png": "./assets/icon-256.png"
  },
  "files": [
    "dist",
    "assets/icon.svg",
    "assets/icon-128.png",
    "assets/icon-256.png",
    "skills",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tui.json --noEmit",
    "build": "node scripts/build.mjs",
    "test": "bun test test/unit",
    "test:kit": "node --test scripts/release-kit.test.mjs",
    "test:tui": "bun test --preload @opentui/solid/preload test/tui",
    "test:host": "node tools/host-tests.mjs",
    "test:pack": "bun test test/pack",
    "lint": "bun test test/forbidden && node scripts/check-copies.mjs",
    "check": "npm run typecheck && npm run build && npm test && npm run test:kit && npm run test:tui && npm run test:host && npm run test:pack && npm run lint && npm run icons && npm run actionlint",
    "check:upstream": "bun tools/check-upstream.mjs",
    "icons": "node scripts/check-icons.mjs",
    "actionlint": "node scripts/check-actionlint.mjs",
    "capture": "node scripts/capture-tools.mjs"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.27.1",
    "@opencode/client": "2.4.1",
    "@opencode/plugin": "2.4.1",
    "@opencode/sdk": "2.4.1",
    "@opencode/theme": "2.4.1",
    "@opentui/core": "0.8.0",
    "@opentui/solid": "0.8.0",
    "@we-the-rebel-alliance/source-contract": "github:we-the-rebel-alliance/source-contract#2fd55cdc0c6c1067927fefc403a88bfd18c9a971",
    "@types/bun": "1.4.4",
    "babel-preset-solid": "1.9.16",
    "effect": "4.1.0",
    "esbuild": "0.28.2",
    "solid-js": "1.9.16",
    "typescript": "5.9.3"
  },
  "opencode": {
    "host": ">=2.4.1 <2.5.0",
    "icons": [
      {
        "src": "assets/icon.svg",
        "mimeType": "image/svg+xml",
        "sizes": [
          "any"
        ]
      },
      {
        "src": "assets/icon-128.png",
        "mimeType": "image/png",
        "sizes": [
          "128x128"
        ]
      },
      {
        "src": "assets/icon-256.png",
        "mimeType": "image/png",
        "sizes": [
          "256x256"
        ]
      }
    ],
    "vendor": {
      "id": "tavily",
      "name": "Tavily",
      "domain": "tavily.com",
      "mark": true
    }
  },
  "jelly": {
    "title": "Tavily",
    "summary": "Web search, extract, crawl and research.",
    "icon": "assets/icon.svg",
    "cost": "Every search, extract, map, crawl and research call spends Tavily credits from the signed-in account or key. A research task costs 4-110 credits with mini and 15-250 with pro, and a crawl reads up to 50 pages by default. The plugin sets no spending limit.",
    "tools": [
      {
        "name": "tavily.tavily_search",
        "permission": "tavily_tavily_search",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "tavily.tavily_extract",
        "permission": "tavily_tavily_extract",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "tavily.tavily_map",
        "permission": "tavily_tavily_map",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "tavily.tavily_crawl",
        "permission": "tavily_tavily_crawl",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "tavily.tavily_research",
        "permission": "tavily_tavily_research",
        "effect": "allow",
        "readOnly": false
      }
    ],
    "skills": [
      "tavily",
      "tavily-research"
    ],
    "rpc": [],
    "views": [],
    "signIns": [
      {
        "id": "key",
        "label": "Tavily API key",
        "integration": "tavily",
        "group": "tavily",
        "help": {
          "url": "https://app.tavily.com/home",
          "label": "Get a Tavily API key"
        }
      },
      {
        "id": "account",
        "label": "Tavily account",
        "server": "tavily",
        "group": "tavily"
      }
    ],
    "contributes": {
      "homeFeeds": [],
      "homeWidgets": [],
      "workKinds": [],
      "settings": [
        {
          "key": "access",
          "label": "Access",
          "type": "string",
          "choices": [
            {
              "value": "all",
              "label": "Allowed",
              "description": "Every tool runs without asking, reads and changes alike."
            },
            {
              "value": "ask-changes",
              "label": "Ask before changes",
              "description": "Reads run without asking. Each change asks you first."
            },
            {
              "value": "read-only",
              "label": "Read only",
              "description": "Reads run. Changes never run."
            }
          ],
          "default": "all",
          "description": "all, ask-changes or read-only. Generates default rules for agents with a base allow rule; the five known reads remain allowed."
        },
        {
          "key": "websearch",
          "label": "Web search",
          "type": "boolean",
          "default": true,
          "description": "Make OpenCode's built-in Tavily provider the default for the websearch tool when no websearch setting is configured."
        },
        {
          "key": "executionTimeoutMs",
          "label": "Call time limit",
          "type": "number",
          "integer": true,
          "min": 60000,
          "max": 3600000,
          "default": 900000,
          "description": "How long one call to a Tavily tool can run, in milliseconds: 1 minute to 1 hour. Research needs the most time. The default is 15 minutes."
        }
      ]
    }
  }
}
