{
  "name": "@joe-broadhead/opencode-tavily",
  "version": "0.0.0",
  "description": "Unofficial OpenCode plugin for Tavily web search, extract, map, crawl and research",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tavily"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joe-broadhead/opencode-tavily.git"
  },
  "homepage": "https://github.com/joe-broadhead/opencode-tavily#readme",
  "bugs": {
    "url": "https://github.com/joe-broadhead/opencode-tavily/issues"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js",
    "./icon.svg": "./assets/icon.svg",
    "./icon-128.png": "./assets/icon-128.png",
    "./icon-256.png": "./assets/icon-256.png"
  },
  "files": [
    "dist",
    "assets/icon.svg",
    "assets/icon-128.png",
    "assets/icon-256.png",
    "skills",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tui.json --noEmit",
    "build": "node scripts/build.mjs",
    "test": "bun test test/unit",
    "test:tui": "bun test --preload @opentui/solid/preload test/tui",
    "test:host": "node tools/host-tests.mjs",
    "test:pack": "bun test test/pack",
    "lint": "bun test test/forbidden && node scripts/check-copies.mjs",
    "check": "npm run typecheck && npm run build && npm test && npm run test:tui && npm run test:host && npm run test:pack && npm run lint && npm run icons && npm run actionlint",
    "check:upstream": "bun tools/check-upstream.mjs",
    "icons": "node scripts/check-icons.mjs",
    "actionlint": "node scripts/check-actionlint.mjs"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.27.1",
    "@opencode/client": "2.2.3",
    "@opencode/plugin": "2.2.3",
    "@opencode/sdk": "2.2.3",
    "@opencode/theme": "2.2.3",
    "@opentui/core": "0.8.0",
    "@opentui/solid": "0.8.0",
    "@types/bun": "1.4.4",
    "babel-preset-solid": "1.9.16",
    "esbuild": "0.28.2",
    "solid-js": "1.9.16",
    "typescript": "5.9.3"
  },
  "opencode": {
    "host": ">=2.2.3 <2.3.0",
    "icons": [
      {
        "src": "assets/icon.svg",
        "mimeType": "image/svg+xml",
        "sizes": [
          "any"
        ]
      },
      {
        "src": "assets/icon-128.png",
        "mimeType": "image/png",
        "sizes": [
          "128x128"
        ]
      },
      {
        "src": "assets/icon-256.png",
        "mimeType": "image/png",
        "sizes": [
          "256x256"
        ]
      }
    ],
    "vendor": {
      "id": "tavily",
      "name": "Tavily",
      "domain": "tavily.com"
    }
  },
  "jelly": {
    "title": "Tavily",
    "summary": "Web search, extract, crawl and research.",
    "icon": "assets/icon.svg",
    "tools": [
      {
        "name": "tavily.tavily_search",
        "permission": "tavily_tavily_search",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "tavily.tavily_extract",
        "permission": "tavily_tavily_extract",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "tavily.tavily_map",
        "permission": "tavily_tavily_map",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "tavily.tavily_crawl",
        "permission": "tavily_tavily_crawl",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "tavily.tavily_research",
        "permission": "tavily_tavily_research",
        "effect": "allow",
        "readOnly": true
      }
    ],
    "skills": [
      "tavily",
      "tavily-research"
    ],
    "rpc": [],
    "views": [],
    "signIns": [
      {
        "id": "key",
        "label": "Tavily",
        "integration": "tavily",
        "group": "tavily",
        "help": {
          "url": "https://app.tavily.com/home",
          "label": "Get a Tavily API key"
        }
      },
      {
        "id": "account",
        "label": "Tavily account",
        "server": "tavily",
        "group": "tavily"
      }
    ],
    "contributes": {
      "homeFeeds": [],
      "homeWidgets": [],
      "workKinds": [],
      "settings": [
        {
          "key": "access",
          "label": "Access",
          "type": "string",
          "default": "all",
          "description": "all, ask-changes or read-only. Generates default rules for agents with a base allow rule; the five known reads remain allowed."
        },
        {
          "key": "websearch",
          "label": "Web search",
          "type": "boolean",
          "default": true,
          "description": "Make OpenCode's built-in Tavily provider the default for the websearch tool when no websearch setting is configured."
        }
      ]
    }
  }
}
